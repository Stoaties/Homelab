# Example Talos Worker Configuration
# Generated by: talosctl gen config
# 
# This is a template - actual configuration will be generated
# by running ./scripts/generate-configs.sh
#
# Key sections to customize:
# - machine.network for static IP
# - machine.kubelet for kubelet settings
# 
# DO NOT commit the actual generated worker.yaml!
# It contains sensitive cluster secrets.

version: v1alpha1
machine:
  type: worker
  network:
    hostname: talos-worker-01
    interfaces:
      - interface: eth0
        addresses:
          - 10.0.1.201/24
        routes:
          - network: 0.0.0.0/0
            gateway: 10.0.0.1
  install:
    disk: /dev/sda
    bootloader: true
    wipe: false

cluster:
  controlPlane:
    endpoint: https://10.0.1.101:6443
