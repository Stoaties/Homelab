# Example Talos Control Plane Configuration
# Generated by: talosctl gen config
# 
# This is a template - actual configuration will be generated
# by running ./scripts/generate-configs.sh
#
# Key sections to customize:
# - machine.network for static IP
# - cluster.network for pod/service CIDRs
# - cluster.controlPlane.endpoint for API server
# 
# DO NOT commit the actual generated controlplane.yaml!
# It contains sensitive cluster secrets.

version: v1alpha1
machine:
  type: controlplane
  network:
    hostname: talos-cp-01
    interfaces:
      - interface: eth0
        addresses:
          - 10.0.1.101/24
        routes:
          - network: 0.0.0.0/0
            gateway: 10.0.0.1
        vip:
          ip: 10.0.1.100
  install:
    disk: /dev/sda
    bootloader: true
    wipe: false
  
cluster:
  controlPlane:
    endpoint: https://10.0.1.101:6443
  network:
    cni:
      name: none
    podSubnets:
      - 10.244.0.0/16
    serviceSubnets:
      - 10.96.0.0/12
